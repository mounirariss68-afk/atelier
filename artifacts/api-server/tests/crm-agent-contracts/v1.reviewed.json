  "releaseLane": "deterministic-offline",
  "description": "Versioned, model-free CRM semantic quality contract. The negative examples are deliberately retained so the evaluator tests its own gates.",
  "evalDefinitions": [
    { "id": "eval-citation-refusal-fact-v1", "fixtureAgent": "scout", "coveredSpecialistIds": ["ag_pursuit_scout", "ag_pov_researcher", "ag_pre_meeting_briefing"], "positiveCaseIds": ["scout-good", "scout-empty"], "negativeCaseIds": ["scout-bad-provenance"] },
    { "id": "eval-pov-fact-promotion-v1", "fixtureAgent": "scout", "coveredSpecialistIds": ["ag_pov_author", "ag_pov_draft"], "positiveCaseIds": ["scout-good"], "negativeCaseIds": ["scout-bad-provenance"], "rule": "Only fact IDs present in the reviewed fact set may be promoted into POV." },
    { "id": "eval-contact-cartographer-v1", "fixtureAgent": "contact", "coveredSpecialistIds": ["ag_account_cartographer"], "positiveCaseIds": ["contact-good"], "negativeCaseIds": ["contact-duplicate", "contact-bad-quality"] },
    { "id": "eval-contact-executive-mapper-v1", "fixtureAgent": "contact", "coveredSpecialistIds": ["ag_executive_mapper"], "positiveCaseIds": ["contact-good"], "negativeCaseIds": ["contact-duplicate", "contact-bad-quality"] },
    { "id": "eval-proposal-approval-v1", "fixtureAgent": "proposal", "coveredSpecialistIds": ["ag_proposal_composer"], "positiveCaseIds": ["proposal-good"], "negativeCaseIds": ["proposal-missing-approval"] },
    { "id": "eval-pricing-margin-override-v1", "fixtureAgent": "pricing", "coveredSpecialistIds": ["ag_pricing_analyst", "ag_pricing_researcher", "ag_pricing_strategist"], "positiveCaseIds": ["pricing-good"], "negativeCaseIds": ["pricing-bad-margin"] },
    { "id": "eval-pipeline-forecast-calibration-v1", "fixtureAgent": "forecast", "coveredSpecialistIds": ["ag_pipeline_forecaster"], "positiveCaseIds": ["forecast-good"], "negativeCaseIds": ["forecast-bad-calibration"] },
    { "id": "eval-global-security-tenant-write-v1", "fixtureAgent": "security", "coveredSpecialistIds": ["ag_brand_profile_writer", "ag_charter_architect", "ag_meeting_scribe", "ag_next_best_action", "ag_procurement_navigator", "ag_qbr_composer", "ag_relationship_health", "ag_strategy_developer", "ag_synthesis_critic", "ag_theme_curator", "ag_whitespace_mapper", "ag_win_loss_interviewer"], "positiveCaseIds": ["security-good"], "negativeCaseIds": ["security-cross-tenant", "security-unauthorized", "security-duplicate-write"], "zeroTolerance": ["security", "authorization/approval", "tenant isolation", "duplicate writes"] }
  ],
  "specialistThresholds": [
