  "excludedSpecialists": [
    { "specialistId": "ag_case_study_picker", "reason": "unsupported embedded Proposal Composer progress label; no independent executor" },
    { "specialistId": "ag_riser_orchestrator", "reason": "utility/orchestrator; no semantic specialist output" },
    { "specialistId": "ag_partner_fit_context", "reason": "utility/context adapter; no independent quality contract" },
    { "specialistId": "ag_run_staleness", "reason": "utility/maintenance job; no semantic specialist output" },
    { "specialistId": "ag_scout_persistence", "reason": "utility/persistence adapter; covered by caller contracts" }
  ],
  "agents": {
    "scout": { "threshold": 0.8, "cases": [
      { "id": "scout-good", "input": { "facts": [{ "id": "f1", "statement": "Market expanding", "sourceUrl": "https://example.com/report" }], "text": "Market expanding [f1]", "expectedEmpty": false }, "output": { "text": "Market expanding [f1]", "factIds": ["f1"], "citations": ["https://example.com/report"], "refused": false } },
      { "id": "scout-empty", "input": { "facts": [], "text": "", "expectedEmpty": true }, "output": { "text": "", "factIds": [], "citations": [], "refused": true } },
      { "id": "scout-bad-provenance", "expectedPass": false, "input": { "facts": [{ "id": "f1", "statement": "Claim", "sourceUrl": "https://example.com/report" }], "text": "Claim", "expectedEmpty": false }, "output": { "text": "Claim [f1]", "factIds": ["f1"], "citations": ["not-a-url"], "refused": false } }
    ] },
    "contact": { "threshold": 0.8, "cases": [
      { "id": "contact-good", "input": { "name": "Ada Lovelace", "email": "ada@example.com", "tenantId": "t1", "existing": [] }, "output": { "name": "Ada Lovelace", "email": "ada@example.com", "tenantId": "t1", "write": true } },
      { "id": "contact-duplicate", "expectedPass": false, "input": { "name": "Ada Lovelace", "email": "ada@example.com", "tenantId": "t1", "existing": ["ada@example.com"] }, "output": { "name": "Ada Lovelace", "email": "ada@example.com", "tenantId": "t1", "write": true } },
      { "id": "contact-bad-quality", "expectedPass": false, "input": { "name": "A", "email": "bad", "tenantId": "t1", "existing": [] }, "output": { "name": "A", "email": "bad", "tenantId": "t1", "write": true } }
    ] },
    "proposal": { "threshold": 0.8, "cases": [
      { "id": "proposal-good", "input": { "requiredSections": ["scope", "price", "approval"], "citations": ["https://example.com/scope"] }, "output": { "sections": ["scope", "price", "approval"], "citationUrls": ["https://example.com/scope"], "approved": true } },
      { "id": "proposal-missing-approval", "expectedPass": false, "input": { "requiredSections": ["scope", "price", "approval"], "citations": [] }, "output": { "sections": ["scope", "price"], "citationUrls": [], "approved": true } }
    ] },
    "pricing": { "threshold": 0.8, "cases": [
      { "id": "pricing-good", "input": { "cost": 40, "price": 100, "targetMargin": 0.55, "approval": true }, "output": { "cost": 40, "price": 100, "margin": 0.6, "approved": true } },
      { "id": "pricing-bad-margin", "expectedPass": false, "input": { "cost": 60, "price": 100, "targetMargin": 0.55, "approval": false }, "output": { "cost": 60, "price": 100, "margin": 0.4, "approved": true } }
    ] },
    "forecast": { "threshold": 0.8, "cases": [
      { "id": "forecast-good", "input": { "actual": 100, "tolerance": 0.1 }, "output": { "forecast": 95 } },
      { "id": "forecast-bad-calibration", "expectedPass": false, "input": { "actual": 100, "tolerance": 0.1 }, "output": { "forecast": 40 } }
    ] },
    "security": { "threshold": 1, "cases": [
      { "id": "security-good", "input": { "tenantId": "t1", "actorTenantId": "t1", "authorized": true, "requiresApproval": false, "duplicateWrite": false }, "output": { "action": "read", "allowed": true } },
      { "id": "security-cross-tenant", "expectedPass": false, "input": { "tenantId": "t2", "actorTenantId": "t1", "authorized": true, "requiresApproval": false, "duplicateWrite": false }, "output": { "action": "read", "allowed": true } },
      { "id": "security-unauthorized", "expectedPass": false, "input": { "tenantId": "t1", "actorTenantId": "t1", "authorized": false, "requiresApproval": false, "duplicateWrite": false }, "output": { "action": "write", "allowed": true } },
      { "id": "security-duplicate-write", "expectedPass": false, "input": { "tenantId": "t1", "actorTenantId": "t1", "authorized": true, "requiresApproval": false, "duplicateWrite": true }, "output": { "action": "write", "allowed": true } }
    ] }
  },
  "liveModelProbes": [
    { "id": "scout-live-tone", "agent": "ag_pursuit_scout", "path": "tests/crm/tone-probe-live.ts", "runWith": "manual-only/online", "reason": "Qualitative prose review against a configured model; never part of the release lane." }
  ],
  "supplementalDeterministicProbes": [
    { "id": "perplexity-provider-contract", "agent": "ag_pov_researcher", "path": "tests/crm/perplexity-research-probe.ts", "runWith": "opt-in/offline", "reason": "Local provider stubs test retrieval failure behavior; no live model or network." }
  ]
