    { "specialistId": "ag_pricing_strategist", "threshold": 0.8, "evalIds": ["eval-pricing-margin-override-v1"] },
    { "specialistId": "ag_procurement_navigator", "threshold": 1, "evalIds": ["eval-global-security-tenant-write-v1"] },
    { "specialistId": "ag_proposal_composer", "threshold": 0.8, "evalIds": ["eval-proposal-approval-v1"] },
