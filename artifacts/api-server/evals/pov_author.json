{
  "agent_id": "pov_author",
  "prompt_version": 1,
  "cases": [
    {
      "id": "pov_01_outline_4_to_6_sections",
      "phase": "outline",
      "input": { "audience": "CIO", "objective": "Argue for unified pricing platform", "factsCount": 8 },
      "asserts": [
        { "kind": "outline_section_count_between", "min": 4, "max": 6 },
        { "kind": "every_section_maps_to_fact" }
      ]
    },
    {
      "id": "pov_02_section_word_band",
      "phase": "sections",
      "input": { "sectionsCount": 5 },
      "asserts": [
        { "kind": "each_section_word_count_between", "min": 150, "max": 280 }
      ]
    },
    {
      "id": "pov_03_citation_coverage",
      "phase": "synthesis_critic",
      "input": { "factsCount": 10 },
      "asserts": [
        { "kind": "coverage_at_least", "value": 0.8 }
      ]
    },
    {
      "id": "pov_04_voice_flags",
      "phase": "synthesis_critic",
      "input": { "draftHasBuzzwords": true },
      "asserts": [
        { "kind": "voice_flags_min", "value": 1 },
        { "kind": "verdict_equals", "value": "revise" }
      ]
    },
    {
      "id": "pov_05_html_render",
      "phase": "stylist",
      "input": {},
      "asserts": [
        { "kind": "html_has_h1" },
        { "kind": "html_citations_use_sup_tag" },
        { "kind": "word_count_within", "min": 600, "max": 1800 }
      ]
    },
    {
      "id": "pov_06_deterministic_gate_hallucinated_ids",
      "phase": "server_citation_gate",
      "input": { "htmlCitesUnknownFactIds": true, "validFactIds": ["f1", "f2"] },
      "asserts": [
        { "kind": "gate_fails_below_threshold", "value": 0.8 },
        { "kind": "invalid_fact_ids_stripped_from_html" },
        { "kind": "failure_lists_unsupported_sections" }
      ]
    },
    {
      "id": "pov_07_inference_labeling_and_implications",
      "phase": "sections",
      "input": { "backgroundContextProvided": true },
      "asserts": [
        { "kind": "background_context_never_cited" },
        { "kind": "each_section_ends_with_client_implication" },
        { "kind": "inference_labeled_not_stated_as_fact" },
        { "kind": "max_jargon_terms_per_section", "value": 2 }
      ]
    },
    {
      "id": "pov_08_deep_research_fact_quality",
      "phase": "deep_research",
      "input": { "anglesCount": 3, "recencyFilter": "month" },
      "asserts": [
        { "kind": "facts_are_atomic_single_claim" },
        { "kind": "source_urls_copied_from_dossier" },
        { "kind": "snippets_carry_publication_dates_when_available" }
      ]
    }
  ]
}
