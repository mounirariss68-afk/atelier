  "dependencies": {
    "@anthropic-ai/sdk": "^0.92.0",
    "@types/multer": "^2.1.0",
    "@workspace/agents": "workspace:*",
    "@workspace/api-zod": "workspace:*",
    "@workspace/assessments": "workspace:*",
    "@workspace/db": "workspace:*",
    "@workspace/integrations-anthropic-ai": "workspace:*",
    "@workspace/cognirise-content": "workspace:*",
    "cheerio": "^1.2.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2",
    "docx": "^9.6.1",
    "drizzle-orm": "catalog:",
    "express": "^5",
    "multer": "^2.1.1",
    "node-cron": "^4.2.1",
    "openai": "^6.35.0",
    "pdfkit": "^0.15.0",
    "pino": "^9",
    "pino-http": "^10",
    "playwright-core": "^1.59.1",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "tsx": "catalog:",
    "@types/express": "^5.0.6",
    "@types/node": "catalog:",
    "@types/node-cron": "^3.0.11",
    "@types/pdfkit": "^0.13.4",
    "esbuild": "^0.27.3",
    "esbuild-plugin-pino": "^2.3.3",
    "pino-pretty": "^13",
    "thread-stream": "3.1.0"
  }
