{
  "$schema": "https://tr.designtokens.org/format/",
  "$description": "Cognirise Atelier design tokens (DTCG). Extracted from the Atelier employee portal (artifacts/atelier/src/index.css). Dark = Atelier's default deep-navy theme; light = its data-theme=\"light\" cool off-white theme. Core accents map by VALUE from the Cognirise gradient: primary = magenta (Atelier's --gold), secondary = purple (--gold-deep), accent = coral (--gold-soft dark). THIS FILE IS THE SINGLE SOURCE OF TRUTH — edit here only; never hand-edit src/index.css or src/generated/tokens.tsx.",
  "color": {
    "$type": "color",
    "light": {
      "background": { "$value": "#F6F7FB" },
      "foreground": { "$value": "#0A1230" },
      "border": { "$value": "#D8DEEC" },
      "card": { "$value": "#FFFFFF" },
      "cardForeground": { "$value": "#0A1230" },
      "popover": { "$value": "#F1F3FA" },
      "popoverForeground": { "$value": "#0A1230" },
      "primary": {
        "$value": "#A6348F",
        "$description": "Cognirise magenta, deepened for AA on light surfaces (Atelier light --gold)."
      },
      "primaryForeground": { "$value": "#FFFFFF" },
      "secondary": { "$value": "#7A2E6E" },
      "secondaryForeground": { "$value": "#FFFFFF" },
      "muted": { "$value": "#F1F3FA" },
      "mutedForeground": { "$value": "#4A5675" },
      "accent": { "$value": "#FF7B5A" },
      "accentForeground": { "$value": "#070B22" },
      "destructive": { "$value": "#B91C1C" },
      "destructiveForeground": { "$value": "#FFFFFF" },
      "input": { "$value": "#D8DEEC" },
      "ring": { "$value": "#A6348F" },
      "chart1": { "$value": "#5B7CFF" },
      "chart2": { "$value": "#8A5BD6" },
      "chart3": { "$value": "#A6348F" },
      "chart4": { "$value": "#FF7B5A" },
      "chart5": { "$value": "#15803D" },
      "sidebar": { "$value": "#FFFFFF" },
      "sidebarForeground": { "$value": "#0A1230" },
      "sidebarBorder": { "$value": "#D8DEEC" },
      "sidebarPrimary": { "$value": "#A6348F" },
      "sidebarPrimaryForeground": { "$value": "#FFFFFF" },
      "sidebarAccent": { "$value": "#F1F3FA" },
      "sidebarAccentForeground": { "$value": "#0A1230" },
      "sidebarRing": { "$value": "#A6348F" }
    },
    "dark": {
      "background": { "$value": "#0A1230" },
      "foreground": { "$value": "#EEF1FA" },
      "border": { "$value": "#2A3566" },
      "card": { "$value": "#141C42" },
      "cardForeground": { "$value": "#EEF1FA" },
      "popover": { "$value": "#1B2755" },
      "popoverForeground": { "$value": "#EEF1FA" },
      "primary": {
        "$value": "#C45BB8",
        "$description": "Cognirise magenta (Atelier dark --gold — magenta by value despite the legacy name)."
      },
      "primaryForeground": { "$value": "#070B22" },
      "secondary": { "$value": "#8A5BD6" },
      "secondaryForeground": { "$value": "#FFFFFF" },
      "muted": { "$value": "#1B2755" },
      "mutedForeground": { "$value": "#9BA8C9" },
      "accent": { "$value": "#FF7B5A" },
      "accentForeground": { "$value": "#070B22" },
      "destructive": { "$value": "#F87171" },
      "destructiveForeground": { "$value": "#070B22" },
      "input": { "$value": "#2A3566" },
      "ring": { "$value": "#C45BB8" },
      "chart1": { "$value": "#5B7CFF" },
      "chart2": { "$value": "#8A5BD6" },
      "chart3": { "$value": "#C45BB8" },
      "chart4": { "$value": "#FF7B5A" },
      "chart5": { "$value": "#4ADE80" },
      "sidebar": { "$value": "#141C42" },
      "sidebarForeground": { "$value": "#EEF1FA" },
      "sidebarBorder": { "$value": "#2A3566" },
      "sidebarPrimary": { "$value": "#C45BB8" },
      "sidebarPrimaryForeground": { "$value": "#070B22" },
      "sidebarAccent": { "$value": "#1B2755" },
      "sidebarAccentForeground": { "$value": "#EEF1FA" },
      "sidebarRing": { "$value": "#C45BB8" }
    }
  },
  "typography": {
    "fontFamily": {
      "$type": "fontFamily",
      "sans": {
        "$value": ["Plus Jakarta Sans", "system-ui", "-apple-system", "sans-serif"],
        "$description": "Default UI and body typeface (Atelier --font-sans)."
      },
      "serif": {
        "$value": ["Plus Jakarta Sans", "Georgia", "serif"],
        "$description": "Atelier's --font-serif deliberately resolves to Plus Jakarta Sans (italic accents use font-style, not a separate face)."
      },
      "mono": {
        "$value": ["ui-monospace", "SFMono-Regular", "Menlo", "monospace"],
        "$description": "Eyebrows, section labels, telemetry chips (Atelier --font-mono)."
      }
    }
  },
  "radius": {
    "$type": "dimension",
    "base": {
      "$value": "0.625rem",
      "$description": "Atelier --radius: 10px. Cards use the 16px large radius (--radius-xl override in the brand layer)."
    }
  },
  "spacing": {
    "$type": "dimension",
    "base": {
      "$value": "0.25rem",
      "$description": "Base spacing step components multiply."
    }
  }
}
