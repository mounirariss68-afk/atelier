{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@workspace/db": [
        "./stubs/db/index.ts"
      ]
    },
    "types": [
      "node"
    ],
    "noImplicitAny": false
  },
  "include": [
    "src/**/*.ts",
    "stubs/**/*.ts"
  ]
}