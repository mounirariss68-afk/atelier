{
  "name": "pricing_strategist deterministic numeric + margin-lock chip",
  "description": "Verifies that the deterministic pricing engine produces stable cost/price/margin outputs and that classifyMarginGate maps margin to the correct chip + override/countersign requirements under three policy configurations (default, tightened red, distinct two-partner threshold).",
  "rateCard": {
    "id": "rc_aico_2026_ksa_uae_v1",
    "rows": [
      { "seniority": "Partner",            "role": "Partner",           "dayRateInternalCost": 2000, "dayRateClientPrice": 6800, "overheadPct": 0.35 },
      { "seniority": "Principal",          "role": "Principal",         "dayRateInternalCost": 1600, "dayRateClientPrice": 5200, "overheadPct": 0.35 },
      { "seniority": "SubjectMatterLead",  "role": "SubjectMatterLead", "dayRateInternalCost": 1200, "dayRateClientPrice": 3800, "overheadPct": 0.35 },
      { "seniority": "AIEngineer",         "role": "AIEngineer",        "dayRateInternalCost": 960,  "dayRateClientPrice": 3000, "overheadPct": 0.35 },
      { "seniority": "Designer",           "role": "Designer",          "dayRateInternalCost": 760,  "dayRateClientPrice": 2360, "overheadPct": 0.35 },
      { "seniority": "Analyst",            "role": "Analyst",           "dayRateInternalCost": 560,  "dayRateClientPrice": 1800, "overheadPct": 0.35 }
    ]
  },
  "scenarios": [
    {
      "id": "s_green_default",
      "policy": { "targetMarginPct": 0.55, "amberThresholdPct": 0.50, "redThresholdPct": 0.45, "twoPartnerThresholdPct": 0.45 },
      "teamMix": [
        { "seniority": "Principal", "ftePct": 0.5 },
        { "seniority": "AIEngineer", "ftePct": 1.0 },
        { "seniority": "Analyst", "ftePct": 1.0 }
      ],
      "durationWeeks": 8,
      "expect": {
        "marginLockStatus": "green",
        "partnerOverrideRequired": false,
        "twoPartnerRequired": false
      }
    },
    {
      "id": "s_amber_default",
      "policy": { "targetMarginPct": 0.55, "amberThresholdPct": 0.50, "redThresholdPct": 0.45, "twoPartnerThresholdPct": 0.45 },
      "marginPctOverride": 0.48,
      "expect": {
        "marginLockStatus": "amber",
        "partnerOverrideRequired": true,
        "twoPartnerRequired": false
      }
    },
    {
      "id": "s_red_default",
      "policy": { "targetMarginPct": 0.55, "amberThresholdPct": 0.50, "redThresholdPct": 0.45, "twoPartnerThresholdPct": 0.45 },
      "marginPctOverride": 0.40,
      "expect": {
        "marginLockStatus": "red",
        "partnerOverrideRequired": true,
        "twoPartnerRequired": true
      }
    },
    {
      "id": "s_split_thresholds",
      "description": "redThreshold 0.50 but twoPartnerThreshold 0.40 — proves no deadlock between submit-gate, override and countersign when thresholds differ.",
      "policy": { "targetMarginPct": 0.55, "amberThresholdPct": 0.52, "redThresholdPct": 0.50, "twoPartnerThresholdPct": 0.40 },
      "marginPctOverride": 0.45,
      "expect": {
        "marginLockStatus": "red",
        "partnerOverrideRequired": true,
        "twoPartnerRequired": false,
        "submitRequiresCountersign": false,
        "countersignEndpointShouldRefuse": true
      }
    },
    {
      "id": "s_split_thresholds_below_two_partner",
      "policy": { "targetMarginPct": 0.55, "amberThresholdPct": 0.52, "redThresholdPct": 0.50, "twoPartnerThresholdPct": 0.40 },
      "marginPctOverride": 0.35,
      "expect": {
        "marginLockStatus": "red",
        "partnerOverrideRequired": true,
        "twoPartnerRequired": true
      }
    },
    {
      "id": "s_strategist_input_filters_alternatives",
      "description": "Asserts that strategist input alternative_lenses=['retainer'] yields exactly one alternative (retainer) instead of all three, proving primaryIntent/alternativeLenses actually drive the run.",
      "strategistInput": {
        "primary_intent": "land_and_expand",
        "alternative_lenses": ["retainer"]
      },
      "policy": { "targetMarginPct": 0.55, "amberThresholdPct": 0.50, "redThresholdPct": 0.45, "twoPartnerThresholdPct": 0.45 },
      "teamMix": [
        { "seniority": "Principal", "ftePct": 0.5 },
        { "seniority": "AIEngineer", "ftePct": 1.0 },
        { "seniority": "Analyst", "ftePct": 1.0 }
      ],
      "durationWeeks": 8,
      "expect": {
        "alternativesCount": 1,
        "alternativePricingModels": ["retainer"],
        "narrativeContains": ["land_and_expand", "retainer"]
      }
    },
    {
      "id": "s_strategist_input_default_keeps_all_three",
      "description": "Backwards-compat: empty strategist input still returns all 3 alternatives.",
      "strategistInput": {},
      "policy": { "targetMarginPct": 0.55, "amberThresholdPct": 0.50, "redThresholdPct": 0.45, "twoPartnerThresholdPct": 0.45 },
      "teamMix": [
        { "seniority": "Principal", "ftePct": 0.5 },
        { "seniority": "AIEngineer", "ftePct": 1.0 },
        { "seniority": "Analyst", "ftePct": 1.0 }
      ],
      "durationWeeks": 8,
      "expect": {
        "alternativesCount": 3,
        "alternativePricingModels": ["fixed_fee", "outcome_based", "retainer"]
      }
    }
  ]
}
