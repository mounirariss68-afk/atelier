modules = ["nodejs-24", "python-3.11", "postgresql-16"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true
integrations = ["perplexity:1.0.0"]

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 90000

[nix]
channel = "stable-25_05"

[[ports]]
localPort = 8080
externalPort = 8080

[[ports]]
localPort = 8081
externalPort = 8081

[[ports]]
localPort = 8082
externalPort = 3001

[[ports]]
localPort = 20132
externalPort = 3003

[[ports]]
localPort = 22132
externalPort = 3000

[[ports]]
localPort = 23742
externalPort = 80

[[ports]]
localPort = 24797
externalPort = 3002

[objectStorage]
defaultBucketID = "replit-objstore-0588d38c-d237-463d-bd67-c15053c7faa2"

[userenv]

[userenv.development]

[userenv.shared]
