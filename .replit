modules = ["nodejs-24", "python-3.11", "postgresql-16"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Generate dossiers"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "test-crm"

[[workflows.workflow]]
name = "Generate dossiers"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "bash .local/scripts/run-all.sh"

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow]]
name = "test-crm"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/api-server run test:crm"

[workflows.workflow.metadata]
isValidation = true

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 90000

[nix]
channel = "stable-25_05"

[[ports]]
localPort = 8080
externalPort = 8080

[[ports]]
localPort = 8081
externalPort = 8081

[[ports]]
localPort = 8082
externalPort = 3000

[[ports]]
localPort = 8083
externalPort = 3003

[[ports]]
localPort = 8084
externalPort = 4200

[[ports]]
localPort = 22132
externalPort = 80

[[ports]]
localPort = 23742
externalPort = 3002

[[ports]]
localPort = 24797
externalPort = 3001
