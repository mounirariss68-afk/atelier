modules = ["nodejs-24", "python-3.11", "postgresql-16"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Generate dossiers"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "test-crm"

[[workflows.workflow]]
name = "Generate dossiers"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "bash .local/scripts/run-all.sh"

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow]]
name = "test-crm"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/api-server run test:crm"

[workflows.workflow.metadata]
isValidation = true

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 90000

[nix]
channel = "stable-25_05"
